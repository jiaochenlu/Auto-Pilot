 884: function renderMarkdown(src) {
 885:   const lines = String(src).replace(/\r\n?/g, "\n").split("\n");
 886:   const out = [];
 887:   let i = 0;
 888:   const flushPara = (buf) => { if (buf.length) { out.push(`<p>${inlineMd(buf.join(" "))}</p>`); buf.length = 0; } };
 889:   const paraBuf = [];
 890:   while (i < lines.length) {
 891:     const line = lines[i];
 892:     // fenced code
 893:     const fence = line.match(/^```(\w*)\s*$/);
 894:     if (fence) {
 895:       flushPara(paraBuf);
 896:       const lang = fence[1] || "";
 897:       const codeLines = [];
 898:       i++;
 899:       while (i < lines.length && !/^```\s*$/.test(lines[i])) { codeLines.push(lines[i]); i++; }
 900:       i++;
 901:       out.push(`<pre class="md-pre"><code${lang ? ` class="lang-${escapeHtml(lang)}"` : ""}>${escapeHtml(codeLines.join("\n"))}</code></pre>`);
 902:       continue;
 903:     }
 904:     // heading
 905:     const h = line.match(/^(#{1,6})\s+(.*)$/);
 906:     if (h) { flushPara(paraBuf); out.push(`<h${h[1].length} class="md-h">${inlineMd(h[2])}</h${h[1].length}>`); i++; continue; }
 907:     // hr
 908:     if (/^\s*([-*_])\s*\1\s*\1[-*_\s]*$/.test(line)) { flushPara(paraBuf); out.push('<hr class="md-hr" />'); i++; continue; }
 909:     // blockquote
 910:     if (/^>\s?/.test(line)) {
 911:       flushPara(paraBuf);
 912:       const qLines = [];
 913:       while (i < lines.length && /^>\s?/.test(lines[i])) { qLines.push(lines[i].replace(/^>\s?/, "")); i++; }
 914:       out.push(`<blockquote class="md-quote">${inlineMd(qLines.join(" "))}</blockquote>`);
 915:       continue;
 916:     }
 917:     // table (simple)
 918:     if (i + 1 < lines.length && /\|/.test(line) && /^\s*\|?[\s:|-]+\|[\s:|-]+$/.test(lines[i + 1])) {
 919:       flushPara(paraBuf);
 920:       const splitRow = (r) => r.replace(/^\s*\|/, "").replace(/\|\s*$/, "").split("|").map((c) => c.trim());
 921:       const headCells = splitRow(line);
 922:       i += 2;
 923:       const bodyRows = [];
 924:       while (i < lines.length && /\|/.test(lines[i]) && lines[i].trim() !== "") { bodyRows.push(splitRow(lines[i])); i++; }
 925:       const thead = `<thead><tr>${headCells.map((c) => `<th>${inlineMd(c)}</th>`).join("")}</tr></thead>`;
 926:       const tbody = `<tbody>${bodyRows.map((r) => `<tr>${r.map((c) => `<td>${inlineMd(c)}</td>`).join("")}</tr>`).join("")}</tbody>`;
 927:       out.push(`<div class="md-table-wrap"><table class="md-table">${thead}${tbody}</table></div>`);
 928:       continue;
 929:     }
 930:     // list (ul/ol, single level for simplicity but supports nested via indent grouping)
 931:     if (/^\s*([-*+]|\d+\.)\s+/.test(line)) {
 932:       flushPara(paraBuf);
 933:       const ordered = /^\s*\d+\.\s+/.test(line);
 934:       const items = [];
 935:       while (i < lines.length && /^\s*([-*+]|\d+\.)\s+/.test(lines[i])) {
 936:         items.push(lines[i].replace(/^\s*([-*+]|\d+\.)\s+/, ""));
 937:         i++;
 938:       }
 939:       const tag = ordered ? "ol" : "ul";
 940:       out.push(`<${tag} class="md-list">${items.map((it) => `<li>${inlineMd(it)}</li>`).join("")}</${tag}>`);
 941:       continue;
 942:     }
 943:     // blank line
 944:     if (!line.trim()) { flushPara(paraBuf); i++; continue; }
 945:     paraBuf.push(line);
 946:     i++;
 947:   }
 948:   flushPara(paraBuf);
 949:   return out.join("\n");
 950: }
 951: 
 952: function inlineMd(text) {
 953:   let s = escapeHtml(text);
 954:   s = s.replace(/`([^`]+)`/g, '<code class="md-code">$1</code>');
 955:   s = s.replace(/!\[([^\]]*)\]\(([^)\s]+)\)/g, (_, alt, url) => `<img alt="${alt}" src="${url}" class="md-img" />`);
 956:   s = s.replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, '<a href="$2" target="_blank" rel="noreferrer noopener">$1</a>');
 957:   s = s.replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>");
 958:   s = s.replace(/(^|[^*])\*([^*]+)\*/g, "$1<em>$2</em>");
 959:   s = s.replace(/~~([^~]+)~~/g, "<del>$1</del>");
 960:   return s;
 961: }
