 235:   padding: 4px 10px 16px;
 236:   flex: 1;
 237:   min-height: 0;
 238: }
 239: .task-row {
 240:   width: 100%;
 241:   min-width: 0;
 242:   text-align: left;
 243:   display: grid;
 244:   gap: 5px;
 245:   padding: 10px 12px;
 246:   margin-bottom: 2px;
 247:   background: transparent;
 248:   border: 1px solid transparent;
 249:   border-radius: var(--radius);
 250:   min-height: auto;
 251:   white-space: normal;
 252:   overflow: hidden;
 253:   text-overflow: clip;
 254:   transition: background var(--transition), border-color var(--transition);
 255: }
 256: .task-row:hover { background: var(--panel-2); }
 257: .task-row.active {
 258:   background: var(--accent-soft);
 259:   border-color: #d6d8fb;
 260: }
 261: .task-row.active .task-title { color: var(--accent-hover); }
 262: .task-row-top {
 263:   display: grid;
 264:   grid-template-columns: minmax(0, 1fr) auto;
 265:   gap: 8px;
 266:   align-items: center;
 267: }
 268: .task-title {
 269:   min-width: 0;
 270:   font-weight: 600;
 271:   font-size: 13px;
 272:   color: var(--ink);
 273:   overflow: hidden;
 274:   text-overflow: ellipsis;
 275:   white-space: nowrap;
 276: }
 277: .task-sub {
 278:   display: flex;
 279:   gap: 8px;
 280:   align-items: center;
 281:   color: var(--muted-2);
 282:   font-size: 11px;
 283:   font-family: var(--mono);
 284:   min-width: 0;
 285:   overflow: hidden;
 286: }
 287: .task-sub > span {
 288:   min-width: 0;
 289:   overflow: hidden;
 290:   text-overflow: ellipsis;
 291:   white-space: nowrap;
 292: }
 293: .task-sub > .task-id { flex: 1 1 auto; }
 294: .task-sub > span:not(.task-id) { flex: 0 1 auto; }
 295: 
 296: /* ---------- Badges ---------- */
 297: .badge {
 298:   display: inline-flex;
 299:   align-items: center;
 300:   gap: 4px;
 301:   max-width: 100%;
 302:   min-height: 20px;
 303:   padding: 2px 8px;
 304:   border: 1px solid transparent;
 305:   border-radius: 999px;
 306:   font-size: 10px;
 307:   font-weight: 600;
 308:   text-transform: uppercase;
 309:   letter-spacing: .05em;
 310:   white-space: nowrap;
 311:   overflow: hidden;
 312:   text-overflow: ellipsis;
 313:   background: var(--gray-soft);
 314:   color: var(--gray);
 315:   flex: 0 1 auto;
 316: }
 317: .status-WAITING_FOR_ANALYSIS_REVIEW { background: var(--amber-soft); color: var(--amber); border-color: #f4d99a; }
 318: .status-WAITING_FOR_ALIGNMENT { background: var(--green-soft); color: var(--green); border-color: #b4ecc8; }
 319: .status-WAITING_FOR_HUMAN { background: var(--red-soft); color: var(--red); border-color: #f4bdba; }
 320: .status-READY_TO_START { background: var(--blue-soft); color: var(--blue); border-color: #c3d8fb; }
 321: .status-DESIGNING,
 322: .status-IMPLEMENTING_AND_TESTING,
 323: .status-REVIEWING { background: var(--cyan-soft); color: var(--cyan); border-color: #a8e6f0; }
 324: .status-DONE { background: var(--green-soft); color: var(--green); border-color: #b4ecc8; }
 325: .status-BLOCKED { background: var(--red-soft); color: var(--red); border-color: #f4bdba; }
 326: .status-UNKNOWN { background: var(--gray-soft); color: var(--gray); border-color: #d8dde6; }
 327: .status-CANCELLED { background: var(--gray-soft); color: var(--gray); border-color: #d8dde6; }
 328: 
 329: /* ---------- Main / Detail ---------- */
 330: .main { min-width: 0; overflow: hidden; background: var(--bg); }
 331: .detail-panel { height: 100vh; display: flex; flex-direction: column; min-width: 0; }
 332: .detail-header {
 333:   display: grid;
 334:   grid-template-columns: minmax(0, 1fr) auto;
 335:   align-items: flex-start;
 336:   gap: 20px;
 337:   padding: 22px 28px 18px;
 338:   background: var(--panel);
 339:   border-bottom: 1px solid var(--line);
 340:   min-width: 0;
 341: }
 342: .detail-header > div:first-child { min-width: 0; }
 343: .eyebrow {
 344:   color: var(--muted);
 345:   font-size: 11px;
 346:   font-family: var(--mono);
 347:   margin-bottom: 6px;
 348:   letter-spacing: .02em;
 349:   white-space: nowrap;
 350:   overflow: hidden;
 351:   text-overflow: ellipsis;
 352:   max-width: 100%;
 353: }
 354: .meta {
 355:   color: var(--muted);
 356:   font-size: 12px;
 357:   margin-top: 10px;
 358:   display: flex;
 359:   flex-wrap: wrap;
 360:   gap: 8px 10px;
 361:   align-items: center;
 362:   min-width: 0;
 363: }
 364: .meta > span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100%; }
 365: .actions {
 366:   display: flex;
 367:   flex-wrap: wrap;
 368:   gap: 8px;
 369:   justify-content: flex-end;
 370:   align-items: center;
 371:   flex-shrink: 0;
 372: }
 373: .actions button { min-width: 0; }
 374: #primaryActionBtn { min-height: 36px; padding: 0 18px; font-weight: 600; }
 375: #primaryActionBtn[hidden] { display: none !important; }
 376: .actions button[hidden], .more-menu[hidden] { display: none !important; }
 377: .more-menu { position: relative; }
 378: .more-menu-pop {
 379:   position: absolute;
 380:   right: 0;
 381:   top: calc(100% + 6px);
 382:   background: var(--panel);
 383:   border: 1px solid var(--line);
 384:   border-radius: var(--radius);
 385:   box-shadow: var(--shadow-lg);
 386:   padding: 6px;
 387:   display: grid;
 388:   gap: 2px;
 389:   min-width: 180px;
 390:   z-index: 50;
 391: }
 392: .more-menu-pop button[hidden] { display: none; }
 393: .more-menu-pop button {
 394:   display: block;
 395:   width: 100%;
 396:   text-align: left;
 397:   padding: 8px 12px;
 398:   background: transparent;
 399:   border: none;
 400:   border-radius: var(--radius-sm);
 401:   font-size: 13px;
 402:   color: var(--ink);
 403: }
 404: .more-menu-pop button:hover:not(:disabled) { background: var(--panel-2); }
 405: .more-menu-pop button.danger:hover:not(:disabled) { background: var(--red-soft); color: var(--red); }
 406: .more-menu-pop button:disabled { color: var(--muted); cursor: not-allowed; }
 407: 
 408: /* ---------- Lifecycle pipeline ---------- */
 409: .lifecycle {
 410:   display: flex;
 411:   align-items: stretch;
 412:   gap: 0;
 413:   list-style: none;
 414:   margin: 0;
 415:   padding: 14px 28px 10px;
 416:   background: var(--panel);
 417:   border-bottom: 1px solid var(--line);
 418:   overflow-x: auto;
 419: }
 420: .lc-step { flex: 1 1 0; min-width: 140px; position: relative; }
 421: .lc-step:not(:last-child)::after {
 422:   content: "";
 423:   position: absolute;
 424:   left: 18px;
 425:   width: 100%;
 426:   top: 18px;
 427:   height: 2px;
 428:   background: var(--line);
 429:   z-index: 0;
 430: }
 431: .lc-step.lc-done:not(:last-child)::after { background: var(--accent); }
 432: .lc-roles { display: flex; flex-wrap: wrap; gap: 4px 6px; margin-top: 6px; }
 433: .lc-role { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px 2px 3px; border: 1px solid var(--line); border-radius: 999px; background: var(--panel, #fff); font-size: 11px; line-height: 1.4; color: var(--text-muted, #6b7280); white-space: nowrap; }
 434: .lc-role-icon { display: inline-flex; align-items: center; justify-content: center; width: 16px; height: 16px; border-radius: 50%; background: var(--line); color: var(--text, #111); font-size: 10px; font-weight: 600; }
 435: .lc-step.lc-current .lc-role { border-color: var(--accent); color: var(--text, #111); }
 436: .lc-step.lc-current .lc-role-icon { background: var(--accent); color: #fff; }
 437: .lc-step.lc-done .lc-role { border-color: var(--accent); color: var(--accent); }
 438: .lc-step.lc-done .lc-role-icon { background: var(--accent); color: #fff; }
 439: .lc-btn {
 440:   position: relative;
 441:   z-index: 1;
 442:   width: 100%;
 443:   display: grid;
 444:   grid-template-columns: 28px 1fr;
 445:   align-items: start;
 446:   gap: 10px;
 447:   padding: 4px 12px 6px 4px;
 448:   background: transparent;
 449:   border: none;
 450:   border-radius: var(--radius-sm);
 451:   text-align: left;
 452:   cursor: pointer;
 453:   min-width: 0;
 454: }
 455: .lc-btn:hover { background: var(--panel-2); }
 456: .lc-btn:disabled, .lc-btn[data-state="pending"] { cursor: not-allowed; opacity: 0.55; }
 457: .lc-btn:disabled:hover, .lc-btn[data-state="pending"]:hover { background: transparent; }
 458: .lc-dot {
 459:   width: 28px;
 460:   height: 28px;
 461:   border-radius: 50%;
 462:   display: grid;
 463:   place-items: center;
 464:   font-size: 12px;
 465:   font-weight: 600;
 466:   background: var(--panel);
 467:   border: 2px solid var(--line);
 468:   color: var(--muted);
 469:   font-variant-numeric: tabular-nums;
 470: }
 471: .lc-text { display: grid; gap: 1px; min-width: 0; }
 472: .lc-label {
 473:   font-size: 12px;
 474:   font-weight: 600;
 475:   color: var(--muted);
 476:   white-space: nowrap;
 477:   overflow: hidden;
 478:   text-overflow: ellipsis;
 479: }
 480: .lc-sub {
 481:   font-size: 11px;
 482:   color: var(--muted);
 483:   white-space: nowrap;
 484:   overflow: hidden;
 485:   text-overflow: ellipsis;
 486: }
 487: .lc-done .lc-dot { background: var(--accent); border-color: var(--accent); color: #fff; }
 488: .lc-done .lc-label { color: var(--ink-soft); }
 489: .lc-current .lc-dot {
 490:   background: #fff;
 491:   border-color: var(--accent);
 492:   color: var(--accent);
 493:   box-shadow: 0 0 0 4px var(--accent-soft);
 494: }
 495: .lc-current .lc-label { color: var(--accent-hover); }
 496: .lc-cancelled .lc-dot { border-color: var(--red); color: var(--red); box-shadow: 0 0 0 4px var(--red-soft); }
 497: .lc-cancelled .lc-label { color: var(--red); }
 498: 
 499: /* ---------- Tab subtitles ---------- */
 500: .tabs button { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; padding: 6px 14px; min-height: 52px; gap: 1px; }
 501: .tab-name { font-size: 13px; font-weight: 600; }
 502: .tab-sub { font-size: 11px; color: var(--muted); font-weight: 400; }
 503: .tabs button.active .tab-sub { color: var(--accent); opacity: 0.75; }
 504: 
 505: /* ---------- Overview CTA ---------- */
 506: .overview-cta {
 507:   position: sticky;
 508:   bottom: 0;
 509:   display: flex;
 510:   align-items: center;
 511:   justify-content: space-between;
 512:   gap: 16px;
 513:   margin-top: 18px;
 514:   padding: 14px 18px;
 515:   background: var(--accent-soft);
 516:   border: 1px solid var(--accent);
 517:   border-radius: var(--radius-lg);
 518:   box-shadow: var(--shadow-lg);
 519: }
 520: .overview-cta-text { display: grid; gap: 2px; min-width: 0; }
 521: .overview-cta-text strong { font-size: 14px; color: var(--accent-hover); }
 522: .overview-cta-text span { font-size: 12px; color: var(--ink-soft); }
 523: .overview-cta .primary { min-height: 36px; padding: 0 18px; font-weight: 600; white-space: nowrap; }
 524: 
 525: .banner {
 526:   margin: 14px 28px 0;
 527:   padding: 10px 14px;
 528:   border: 1px solid #f4bdba;
 529:   background: var(--red-soft);
 530:   color: var(--red);
 531:   border-radius: var(--radius);
 532:   font-size: 13px;
 533:   word-break: break-word;
 534: }
 535: .hidden { display: none !important; }
 536: 
 537: /* ---------- Tabs ---------- */
 538: .tabs {
 539:   display: flex;
 540:   gap: 4px;
 541:   padding: 0 22px;
 542:   background: var(--panel);
 543:   border-bottom: 1px solid var(--line);
 544:   overflow-x: auto;
 545: }
 546: .tabs button {
 547:   min-height: 42px;
 548:   padding: 0 14px;
 549:   background: transparent;
 550:   border: none;
 551:   border-bottom: 2px solid transparent;
 552:   border-radius: 0;
 553:   color: var(--muted);
 554:   font-size: 13px;
 555:   font-weight: 500;
 556:   white-space: nowrap;
 557: }
 558: .tabs button:hover:not(.active) { color: var(--ink-soft); background: transparent; }
 559: .tabs button.active { color: var(--accent); border-bottom-color: var(--accent); background: transparent; }
 560: 
 561: .tab-panel { display: none; overflow: auto; padding: 22px 28px 28px; flex: 1; min-width: 0; }
 562: .tab-panel.active { display: block; }
 563: 
 564: /* ---------- Overview split ---------- */
 565: .split {
 566:   display: grid;
 567:   grid-template-columns: minmax(0, 1.35fr) minmax(260px, .65fr);
 568:   gap: 18px;
 569:   margin-bottom: 22px;
 570:   min-width: 0;
 571: }
 572: .split > section {
 573:   min-width: 0;
 574:   background: var(--panel);
 575:   border: 1px solid var(--line);
 576:   border-radius: var(--radius-lg);
