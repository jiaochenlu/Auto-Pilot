 714: .design-package-card .dpc-head {
 715:   display: flex;
 716:   align-items: center;
 717:   justify-content: space-between;
 718:   gap: 8px;
 719: }
 720: .design-package-card strong { color: var(--ink); font-size: 13px; }
 721: .design-package-card p { color: var(--ink-soft); font-size: 12px; margin: 0; }
 722: .design-package-card code {
 723:   display: block;
 724:   color: var(--muted);
 725:   font-family: var(--mono);
 726:   font-size: 11px;
 727:   overflow: hidden;
 728:   text-overflow: ellipsis;
 729:   white-space: nowrap;
 730: }
 731: .design-package-card em {
 732:   width: fit-content;
 733:   font-style: normal;
 734:   border-radius: 999px;
 735:   padding: 2px 7px;
 736:   font-size: 11px;
 737:   border: 1px solid var(--line-soft);
 738: }
 739: .design-package-card.is-ready em { color: var(--green); background: var(--green-soft); border-color: #b4ecc8; }
 740: .design-package-card.is-missing em { color: var(--red); background: var(--red-soft); border-color: #f4bdba; }
 741: .approval-artifact-grid {
 742:   display: grid;
 743:   grid-template-columns: repeat(4, minmax(0, 1fr));
 744:   gap: 10px;
 745: }
 746: .approval-artifact {
 747:   min-width: 0;
 748:   display: grid;
 749:   gap: 5px;
 750:   padding: 12px;
 751:   background: #fff;
 752:   border: 1px solid var(--line-soft);
 753:   border-radius: var(--radius-sm);
 754: }
 755: .approval-artifact strong,
 756: .approval-artifact span {
 757:   min-width: 0;
 758:   overflow: hidden;
 759:   text-overflow: ellipsis;
 760:   white-space: nowrap;
 761: }
 762: .approval-artifact strong { color: var(--ink); font-size: 13px; }
 763: .approval-artifact span { color: var(--muted); font-family: var(--mono); font-size: 11px; }
 764: .approval-artifact em {
 765:   width: fit-content;
 766:   font-style: normal;
 767:   border-radius: 999px;
 768:   padding: 2px 7px;
 769:   font-size: 11px;
 770:   border: 1px solid var(--line-soft);
 771: }
 772: .approval-artifact.is-ready em { color: var(--green); background: var(--green-soft); border-color: #b4ecc8; }
 773: .approval-artifact.is-missing em { color: var(--red); background: var(--red-soft); border-color: #f4bdba; }
 774: .human-review-panel.hidden { display: none; }
 775: .human-review-head {
 776:   display: grid;
 777:   grid-template-columns: minmax(0, 1fr) auto;
 778:   gap: 14px;
 779:   align-items: start;
 780: }
 781: .human-review-head h3 { margin-bottom: 4px; color: var(--amber); }
 782: .human-review-head p,
 783: .human-summary {
 784:   color: var(--ink-soft);
 785:   font-size: 13px;
 786: }
 787: .human-review-grid {
 788:   display: grid;
 789:   grid-template-columns: minmax(0, 1fr) minmax(260px, .8fr);
 790:   gap: 14px;
 791: }
 792: .human-review-grid > section {
 793:   min-width: 0;
 794:   display: grid;
 795:   gap: 10px;
 796:   padding: 12px;
 797:   border: 1px solid rgba(138, 90, 4, .18);
 798:   border-radius: var(--radius-sm);
