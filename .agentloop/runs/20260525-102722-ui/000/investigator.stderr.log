1104: async function saveRoleDefaults() {
1105:   const container = $("roleDefaults");
1106:   const saveBtn = $("roleDefaultsSaveBtn");
1107:   const statusEl = $("roleDefaultsStatus");
1108:   const role_runtimes = {};
1109:   for (const select of container.querySelectorAll("select[data-role]")) {
1110:     if (select.value !== select.dataset.original) {
1111:       role_runtimes[select.dataset.role] = select.value;
1112:     }
1113:   }
1114:   if (!Object.keys(role_runtimes).length) return;
1115:   saveBtn.disabled = true;
1116:   statusEl.classList.remove("hidden");
1117:   statusEl.textContent = "Saving…";
1118:   statusEl.classList.remove("saved");
1119:   try {
1120:     state.settings = await apiFetch("/api/settings", { method: "PATCH", body: JSON.stringify({ role_runtimes }) });
1121:     renderSettingsRuntime(state.settings);
1122:     statusEl.classList.remove("hidden");
1123:     statusEl.classList.add("saved");
1124:     statusEl.textContent = "Saved";
1125:     setTimeout(() => statusEl.classList.add("hidden"), 1500);
1126:   } catch (error) {
1127:     statusEl.classList.remove("hidden");
1128:     statusEl.classList.remove("saved");
1129:     statusEl.textContent = error.message;
1130:     saveBtn.disabled = false;
1131:   }
1132: }
