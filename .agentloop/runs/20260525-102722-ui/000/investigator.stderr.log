 662: .framing-review-head h3 { margin-bottom: 4px; color: var(--blue); }
 663: .research-progress-head h3 { margin-bottom: 4px; color: var(--orange, #b8740c); }
 664: .execution-approval-head h3 { margin-bottom: 4px; color: var(--green); }
 665: .framing-review-head p,
 666: .research-progress-head p,
 667: .execution-approval-head p { color: var(--ink-soft); font-size: 13px; }
 668: .question-list { display: grid; gap: 10px; }
 669: .question-item {
 670:   display: grid;
 671:   gap: 7px;
 672:   padding: 12px;
 673:   background: #fff;
 674:   border: 1px solid var(--line-soft);
 675:   border-radius: var(--radius-sm);
 676: }
 677: .question-top {
 678:   display: flex;
 679:   align-items: center;
 680:   justify-content: space-between;
 681:   gap: 10px;
 682: }
 683: .question-top strong { color: var(--ink); }
 684: .question-top em {
 685:   font-style: normal;
 686:   color: var(--muted);
 687:   font-size: 11px;
 688:   border: 1px solid var(--line-soft);
 689:   border-radius: 999px;
 690:   padding: 2px 7px;
 691:   background: var(--panel-2);
 692: }
 693: .question-item > span:not(.question-top),
 694: .question-item small { color: var(--ink-soft); font-size: 13px; }
 695: .question-item small { color: var(--muted); }
 696: .question-item textarea { min-height: 56px; padding: 8px 10px; }
 697: .framing-review-actions,
 698: .execution-approval-actions { display: flex; gap: 10px; justify-content: flex-end; }
 699: .framing-review-actions button[disabled] { opacity: 0.5; cursor: not-allowed; }
 700: .design-package-cards {
 701:   display: grid;
 702:   grid-template-columns: repeat(5, minmax(0, 1fr));
 703:   gap: 10px;
