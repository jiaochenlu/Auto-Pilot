1134: function runtimeEffectiveStatus(item) {
1135:   if (item?.status) return item.status;
1136:   if (item?.selectable || item?.configured || item?.command || item?.adapter === "manual") return "active";
1137:   return "not_injected";
1138: }
1139: 
1140: function runtimeStatusLabel(status) {
1141:   if (status === "active") return "active";
1142:   if (status === "manual_fallback") return "manual fallback";
1143:   if (status === "configured_missing") return "missing";
1144:   if (status === "detected_not_injected") return "detected";
1145:   if (status === "not_injected") return "not injected";
1146:   return "unknown";
1147: }
1148: 
1149: function runtimeStatusDescription(status) {
1150:   if (status === "active") return "configured runtime";
