 380: function renderAcceptance(task) {
 381:   const list = $("acceptanceList");
 382:   if (!list) return;
 383:   list.innerHTML = "";
 384:   const items = task.acceptance_criteria || [];
 385:   const passed = items.filter((ac) => String(ac.status || "").toLowerCase() === "passed").length;
 386:   const failed = items.filter((ac) => String(ac.status || "").toLowerCase() === "failed").length;
 387:   const countEl = $("acceptanceCount");
 388:   if (countEl) {
 389:     countEl.innerHTML = items.length
 390:       ? `<span class="count-chip">${passed}/${items.length} passed</span>${failed ? `<span class="count-chip count-chip-fail">${failed} failed</span>` : ""}`
 391:       : "";
 392:   }
 393:   if (!items.length) {
 394:     list.innerHTML = '<div class="task-sub">No acceptance criteria.</div>';
 395:     return;
 396:   }
 397:   for (const ac of items) {
 398:     const item = document.createElement("details");
 399:     item.className = "ac-item";
 400:     const status = String(ac.status || "pending").toLowerCase();
 401:     const required = ac.required ? "required" : "optional";
 402:     item.innerHTML = `
 403:       <summary class="ac-summary">
 404:         <span class="ac-id">${escapeHtml(ac.id)}</span>
 405:         <span class="ac-req ${ac.required ? "is-required" : "is-optional"}">${required}</span>
 406:         <span class="ac-criterion">${escapeHtml(ac.description)}</span>
 407:         <span class="ac-status ac-status-${escapeHtml(status)}">${escapeHtml(ac.status || "pending")}</span>
 408:         <span class="ac-caret" aria-hidden="true">›</span>
 409:       </summary>
 410:       <div class="ac-body">
 411:         <div class="ac-field"><span class="ac-label">Verification</span><span class="ac-value">${escapeHtml(ac.verification || "-")}</span></div>
 412:         <div class="ac-field"><span class="ac-label">Evidence</span><span class="ac-value">${escapeHtml(ac.evidence || "-")}</span></div>
 413:       </div>`;
 414:     list.appendChild(item);
 415:   }
 416: }
