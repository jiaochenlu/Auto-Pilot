 542: function renderFramingReview(detail) {
 543:   const panel = $("framingReviewPanel");
 544:   const review = detail.framing_review;
 545:   if (!review?.required) {
 546:     panel.classList.add("hidden");
 547:     panel.innerHTML = "";
 548:     panel.dataset.signature = "";
 549:     return;
 550:   }
 551:   if (review.running) {
 552:     panel.classList.remove("hidden");
 553:     const runningSig = `running:${review.error || ""}`;
 554:     if (panel.dataset.signature === runningSig) return;
 555:     panel.dataset.signature = runningSig;
 556:     const errBlock = review.error
 557:       ? `<div class="dialog-error">Framer failed: ${escapeHtml(String(review.error))}</div>`
 558:       : "";
 559:     panel.innerHTML = `
 560:       <div class="framing-review-head">
 561:         <div>
 562:           <h3>Framing</h3>
 563:           <p>Framer is drafting open questions. This page will update automatically when it's ready.</p>
 564:         </div>
 565:         <span class="badge status-FRAMING_REVIEW">FRAMING…</span>
 566:       </div>
 567:       <div class="framing-loading"><span class="spinner" aria-hidden="true"></span> Working…</div>
 568:       ${errBlock}`;
 569:     return;
 570:   }
 571:   const questions = Array.isArray(review.questions) ? review.questions : [];
 572:   const blocking = review.blocking_count || 0;
 573:   const ready = !!review.ready_for_research;
 574:   const badge = ready ? "READY FOR RESEARCH" : (blocking ? `${blocking} BLOCKING` : "NEEDS REVIEW");
 575:   const badgeClass = ready ? "status-READY_TO_START" : "status-FRAMING_REVIEW";
 576:   const signature = `review:${ready ? 1 : 0}:${blocking}:${questions.map((q) => `${q.id}|${q.question}|${q.blocking ? 1 : 0}|${q.answer || ""}`).join("§")}`;
 577:   panel.classList.remove("hidden");
 578:   if (panel.dataset.signature === signature) {
 579:     // Same content — keep existing DOM so the user's in-progress typing is preserved.
 580:     return;
 581:   }
 582:   panel.dataset.signature = signature;
 583:   panel.innerHTML = `
 584:     <div class="framing-review-head">
 585:       <div>
 586:         <h3>Framing</h3>
 587:         <p>${escapeHtml(review.meaning || "Review the problem framing. Answer blocking questions, then start research.")}</p>
 588:       </div>
 589:       <span class="badge ${badgeClass}">${escapeHtml(badge)}</span>
 590:     </div>
 591:     <div class="question-list">
 592:       ${questions.length ? questions.map(renderFramingQuestion).join("") : '<div class="task-sub">No open questions. Click "Start research" to continue.</div>'}
 593:     </div>
 594:     <div class="framing-review-actions">
 595:       <button id="submitFramingBtn" class="secondary" type="button">Submit answers</button>
 596:       <button id="startResearchBtn" class="primary" type="button" ${ready ? "" : "disabled"} title="${ready ? "" : "Answer the required questions first"}">Start research →</button>
 597:     </div>`;
 598:   $("submitFramingBtn").addEventListener("click", submitFramingAnswers);
 599:   $("startResearchBtn").addEventListener("click", startResearch);
 600:   panel.querySelectorAll("textarea[data-question-id]").forEach((ta) => {
 601:     ta.addEventListener("input", () => refreshFramingReadiness(questions));
 602:   });
 603: }
 604: 
 605: const PLACEHOLDER_ANSWERS = new Set(["", "unanswered", "n/a", "na", "tbd", "none"]);
 606: 
 607: function refreshFramingReadiness(questions) {
 608:   const panel = $("framingReviewPanel");
 609:   if (!panel) return;
 610:   const answers = new Map();
 611:   for (const ta of panel.querySelectorAll("textarea[data-question-id]")) {
 612:     answers.set(ta.dataset.questionId, ta.value.trim().toLowerCase());
 613:     if (ta.value.trim()) ta.classList.remove("invalid");
 614:   }
 615:   let blocking = 0;
 616:   for (const q of questions) {
 617:     if (!q || !q.blocking) continue;
 618:     const v = answers.get(String(q.id || "")) ?? "";
 619:     if (PLACEHOLDER_ANSWERS.has(v)) blocking += 1;
 620:   }
 621:   const ready = blocking === 0;
 622:   const badgeEl = panel.querySelector(".framing-review-head .badge");
 623:   if (badgeEl) {
 624:     badgeEl.textContent = ready ? "READY FOR RESEARCH" : `${blocking} BLOCKING`;
 625:     badgeEl.className = `badge ${ready ? "status-READY_TO_START" : "status-FRAMING_REVIEW"}`;
 626:   }
 627: }
 628: 
 629: function renderFramingQuestion(question) {
 630:   const required = question.blocking ? "required" : "optional";
 631:   const raw = String(question.answer || "").trim();
 632:   const answer = raw.toLowerCase() === "unanswered" ? "" : raw;
 633:   return `<label class="question-item">
 634:     <span class="question-top"><strong>${escapeHtml(question.id || "Q")}</strong><em>${escapeHtml(required)}</em></span>
 635:     <span>${escapeHtml(question.question || "Open question")}</span>
 636:     ${question.reason ? `<small>${escapeHtml(question.reason)}</small>` : ""}
 637:     <textarea data-question-id="${escapeHtml(question.id || "")}" rows="2" placeholder="${question.blocking ? "Required answer" : "Optional — leave blank to use Framer assumptions"}">${escapeHtml(answer)}</textarea>
 638:   </label>`;
 639: }
 640: 
 641: async function submitFramingAnswers() {
 642:   if (!state.selectedTaskId) return;
 643:   const panel = $("framingReviewPanel");
 644:   const textareas = Array.from(panel.querySelectorAll("textarea[data-question-id]"));
 645:   const questionsById = new Map();
 646:   const review = state.detail?.framing_review;
 647:   for (const q of (review?.questions || [])) {
 648:     if (q && q.id) questionsById.set(String(q.id), q);
 649:   }
 650:   const missing = [];
 651:   const answers = {};
 652:   for (const input of textareas) {
 653:     const id = input.dataset.questionId;
 654:     const value = input.value.trim();
 655:     answers[id] = value;
 656:     const q = questionsById.get(id);
 657:     const blocking = q ? !!q.blocking : false;
 658:     input.classList.remove("invalid");
 659:     if (blocking && !value) missing.push(input);
 660:   }
 661:   if (missing.length) {
 662:     for (const input of missing) input.classList.add("invalid");
 663:     missing[0].focus();
 664:     showBanner(`Please answer ${missing.length} required question${missing.length === 1 ? "" : "s"} before submitting.`);
 665:     return;
 666:   }
 667:   const btn = $("submitFramingBtn");
 668:   if (btn) { btn.disabled = true; btn.textContent = "Re-framing…"; }
 669:   showBanner("Re-framing problem with your answers…");
 670:   try {
 671:     state.detail = await apiFetch(`/api/tasks/${encodeURIComponent(state.selectedTaskId)}/submit-framing`, { method: "POST", body: JSON.stringify({ by: "ui", answers }) });
 672:     await loadTasks(true);
 673:     showBanner(null);
 674:   } catch (error) {
 675:     showBanner(error.message);
 676:     if (btn) { btn.disabled = false; btn.textContent = "Submit answers"; }
 677:   }
 678: }
 679: 
 680: async function startResearch() {
 681:   if (!state.selectedTaskId) return;
 682:   state.busy = true;
 683:   renderDetail();
 684:   showBanner("Starting research…");
 685:   try {
