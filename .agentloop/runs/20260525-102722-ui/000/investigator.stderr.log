  21: class AgentLoopUIHandler(BaseHTTPRequestHandler):
  22:     server_version = "AgentLoopUI/1.0"
  23: 
  24:     @property
  25:     def root(self) -> Path:
  26:         return self.server.root  # type: ignore[attr-defined]
  27: 
  28:     def log_message(self, format: str, *args: object) -> None:
  29:         print(f"{self.address_string()} - {format % args}", file=sys.stderr)
  30: 
  31:     def _send_json(self, status: int, payload: dict | list) -> None:
  32:         body = json.dumps(payload, indent=2).encode("utf-8")
  33:         self.send_response(status)
  34:         self.send_header("Content-Type", "application/json; charset=utf-8")
  35:         self.send_header("Content-Length", str(len(body)))
  36:         self.end_headers()
  37:         self.wfile.write(body)
  38: 
  39:     def _read_json(self) -> dict:
  40:         length = int(self.headers.get("Content-Length") or "0")
  41:         if length <= 0:
  42:             return {}
  43:         raw = self.rfile.read(length)
  44:         try:
  45:             payload = json.loads(raw.decode("utf-8"))
  46:         except json.JSONDecodeError as exc:
  47:             raise WorkspaceError(f"Invalid JSON payload: {exc}") from exc
  48:         if not isinstance(payload, dict):
  49:             raise WorkspaceError("JSON payload must be an object.")
  50:         return payload
  51: 
  52:     def _handle_error(self, exc: Exception) -> None:
  53:         if isinstance(exc, LockHeld):
  54:             self._send_json(409, api.error_payload(exc))
  55:         elif isinstance(exc, WorkspaceError):
  56:             message = str(exc).lower()
  57:             status = 404 if "not found" in message or "does not exist" in message else 400
  58:             self._send_json(status, api.error_payload(exc))
  59:         else:
  60:             print(f"unexpected ui error: {exc}", file=sys.stderr)
  61:             self._send_json(500, {"error": {"code": "internal_error", "message": "Unexpected server error."}})
  62: 
  63:     def do_GET(self) -> None:
  64:         try:
  65:             parsed = urlparse(self.path)
  66:             path = parsed.path
  67:             if path == "/api/tasks":
  68:                 self._send_json(200, api.build_task_list(self.root))
  69:                 return
  70:             if path == "/api/settings":
  71:                 self._send_json(200, api.build_settings(self.root))
  72:                 return
  73:             parts = [unquote(part) for part in path.split("/") if part]
  74:             if len(parts) == 3 and parts[:2] == ["api", "tasks"]:
  75:                 self._send_json(200, api.build_task_detail(self.root, parts[2]))
  76:                 return
  77:             if len(parts) == 5 and parts[:2] == ["api", "tasks"] and parts[3] == "artifacts":
  78:                 self._send_json(200, api.read_artifact(self.root, parts[2], parts[4]))
  79:                 return
  80:             self._serve_static(path)
  81:         except Exception as exc:
  82:             self._handle_error(exc)
  83: 
  84:     def do_POST(self) -> None:
  85:         try:
  86:             parts = [unquote(part) for part in urlparse(self.path).path.split("/") if part]
  87:             payload = self._read_json()
  88:             if parts == ["api", "tasks"]:
  89:                 self._send_json(201, api.create_task(self.root, payload))
  90:                 return
  91:             if len(parts) == 4 and parts[:2] == ["api", "tasks"]:
  92:                 task_id, op = parts[2], parts[3]
  93:                 if op == "approve":
  94:                     self._send_json(200, api.approve_task_api(self.root, task_id, payload))
  95:                     return
  96:                 if op == "submit-framing":
  97:                     self._send_json(200, api.submit_framing_answers_api(self.root, task_id, payload))
  98:                     return
  99:                 if op == "start-research":
 100:                     self._send_json(200, api.start_research_api(self.root, task_id, payload))
 101:                     return
 102:                 if op == "cancel":
 103:                     self._send_json(200, api.cancel_task_api(self.root, task_id, payload))
 104:                     return
 105:                 if op == "run":
 106:                     self._send_json(200, api.run_task_api(self.root, task_id, payload))
 107:                     return
 108:                 if op == "resume":
 109:                     self._send_json(200, api.resume_task_api(self.root, task_id, payload))
 110:                     return
 111:                 if op == "edit-artifact":
 112:                     self._send_json(200, api.edit_artifact_api(self.root, task_id, payload))
 113:                     return
 114:             self._send_json(404, {"error": {"code": "not_found", "message": "Endpoint not found."}})
 115:         except Exception as exc:
 116:             self._handle_error(exc)
 117: 
 118:     def do_PATCH(self) -> None:
 119:         try:
 120:             parts = [unquote(part) for part in urlparse(self.path).path.split("/") if part]
 121:             if len(parts) == 4 and parts[:2] == ["api", "tasks"] and parts[3] == "config":
 122:                 self._send_json(200, api.patch_task_config(self.root, parts[2], self._read_json()))
 123:                 return
 124:             if parts == ["api", "settings"]:
 125:                 self._send_json(200, api.patch_settings(self.root, self._read_json()))
 126:                 return
 127:             self._send_json(404, {"error": {"code": "not_found", "message": "Endpoint not found."}})
 128:         except Exception as exc:
 129:             self._handle_error(exc)
 130: 
 131:     def do_DELETE(self) -> None:
 132:         try:
 133:             parts = [unquote(part) for part in urlparse(self.path).path.split("/") if part]
 134:             if len(parts) == 3 and parts[:2] == ["api", "tasks"]:
 135:                 self._send_json(200, api.delete_task(self.root, parts[2], self._read_json()))
 136:                 return
 137:             self._send_json(404, {"error": {"code": "not_found", "message": "Endpoint not found."}})
 138:         except Exception as exc:
 139:             self._handle_error(exc)
 140: 
 141:     def _serve_static(self, request_path: str) -> None:
 142:         name = "index.html" if request_path in {"/", ""} else request_path.lstrip("/")
 143:         if ".." in Path(name).parts:
 144:             self.send_error(404)
 145:             return
 146:         path = (STATIC_DIR / name).resolve()
 147:         if not str(path).lower().startswith(str(STATIC_DIR.resolve()).lower()) or not path.is_file():
 148:             self.send_error(404)
 149:             return
 150:         data = path.read_bytes()
 151:         content_type = mimetypes.guess_type(str(path))[0] or "application/octet-stream"
 152:         if path.suffix == ".js":
 153:             content_type = "text/javascript"
 154:         self.send_response(200)
 155:         self.send_header("Content-Type", content_type)
 156:         self.send_header("Content-Length", str(len(data)))
 157:         self.end_headers()
 158:         self.wfile.write(data)
 159: 
 160: 
 161: def serve(root: Path, host: str = "127.0.0.1", port: int = 8765, open_browser: bool = False) -> None:
 162:     class Server(ThreadingHTTPServer):
 163:         pass
 164: 
 165:     server = Server((host, port), AgentLoopUIHandler)
 166:     server.root = root.resolve()  # type: ignore[attr-defined]
 167:     url = f"http://{host}:{server.server_port}"
 168:     print(f"AgentLoop Task Console: {url}")
 169:     print("Press Ctrl+C to stop.")
 170:     if open_browser:
 171:         webbrowser.open(url)
 172:     try:
 173:         server.serve_forever()
 174:     except KeyboardInterrupt:
 175:         print("\nAgentLoop UI stopped.")
 176:     finally:
 177:         server.server_close()

