 136: def runtime_catalog(config: dict[str, Any]) -> list[dict[str, Any]]:
 137:     runtimes = config.get("runtimes", {}) if isinstance(config.get("runtimes"), dict) else {}
 138:     detected = detect_runtime_definitions()
 139:     names = set(RUNTIME_PRESETS) | set(detected) | set(runtimes)
 140:     rows: list[dict[str, Any]] = []
 141:     order = {"active": 0, "manual_fallback": 1, "configured_missing": 2, "detected_not_injected": 3, "not_injected": 4}
 142:     for name in names:
 143:         if name in HIDDEN_UI_RUNTIMES:
 144:             continue
 145:         configured = name in runtimes
 146:         detected_here = name in detected
 147:         runtime = runtimes.get(name) or detected.get(name) or RUNTIME_PRESETS.get(name) or {}
 148:         rows.append(_runtime_row(name, runtime, configured=configured, detected=detected_here))
 149:     rows.sort(key=lambda item: (order.get(str(item.get("status")), 99), str(item.get("name"))))
 150:     return rows
