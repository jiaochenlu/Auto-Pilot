 418: function renderPhaseArtifacts(detail, phase, wantedOverride) {
 419:   const section = $("phaseArtifactSection");
 420:   const body = $("phaseArtifactBody");
 421:   const heading = $("phaseArtifactHeading");
 422:   if (!section || !body) return;
 423:   const wanted = wantedOverride || PHASE_ARTIFACTS[phase] || [];
 424:   const editable = phase === "approval" && !wantedOverride;
 425:   const all = detail.artifacts || [];
 426:   const byName = new Map(all.map((a) => [String(a.name || "").toLowerCase(), a]));
 427:   // For approval, prefer .edited.* if present
 428:   const pick = (base) => {
 429:     if (editable) {
 430:       const edited = byName.get(base.replace(/\.([a-z]+)$/i, ".edited.$1").toLowerCase());
 431:       if (edited) return { artifact: edited, isEdited: true };
 432:     }
 433:     const orig = byName.get(base.toLowerCase());
 434:     return orig ? { artifact: orig, isEdited: false } : null;
 435:   };
 436:   const items = wanted.map(pick).filter(Boolean);
 437:   if (!items.length) {
 438:     section.classList.add("hidden");
 439:     body.innerHTML = "";
 440:     return;
 441:   }
 442:   section.classList.remove("hidden");
 443:   if (heading) {
 444:     heading.textContent = phase === "approval" ? "Design package — editable" : phase === "research" ? "Research outputs" : phase === "framing" ? "Framing" : "Outputs";
 445:   }
 446:   body.innerHTML = "";
 447:   for (const { artifact, isEdited } of items) {
 448:     const node = document.createElement("section");
 449:     node.className = "phase-artifact-card" + (editable ? " is-editable" : "");
 450:     const content = artifact.preview?.content || "";
 451:     const truncated = artifact.preview?.truncated;
 452:     const headHtml = `<div class="phase-artifact-head"><strong>${escapeHtml(artifact.name)}</strong>${isEdited ? '<span class="badge badge-edited">edited</span>' : ""}<span class="task-sub">${artifact.size} bytes${truncated ? ` · truncated` : ""}</span></div>`;
 453:     if (editable && !truncated) {
 454:       node.innerHTML = `${headHtml}
 455:         <textarea class="phase-artifact-editor" data-original-name="${escapeHtml(artifact.name.replace(/\.edited\.([a-z]+)$/i, ".$1"))}" rows="14">${escapeHtml(content)}</textarea>
 456:         <div class="phase-artifact-actions">
 457:           <button type="button" class="phase-artifact-save primary" data-base="${escapeHtml(artifact.name.replace(/\.edited\.([a-z]+)$/i, ".$1"))}">Save edits</button>
 458:           ${isEdited ? `<button type="button" class="phase-artifact-revert" data-base="${escapeHtml(artifact.name.replace(/\.edited\.([a-z]+)$/i, ".$1"))}">Revert to original</button>` : ""}
 459:           <span class="phase-artifact-save-status task-sub"></span>
 460:         </div>`;
 461:     } else {
 462:       node.innerHTML = `${headHtml}<div class="markdown-body">${renderMarkdown(content)}</div>${truncated ? '<div class="task-sub">Preview truncated — open full file from Execution log.</div>' : ""}`;
 463:     }
 464:     body.appendChild(node);
 465:   }
 466:   // Wire edit handlers
 467:   body.querySelectorAll(".phase-artifact-save").forEach((btn) => {
 468:     btn.addEventListener("click", async () => {
 469:       const base = btn.dataset.base;
 470:       const textarea = btn.closest(".phase-artifact-card").querySelector(".phase-artifact-editor");
 471:       const statusEl = btn.parentElement.querySelector(".phase-artifact-save-status");
 472:       if (statusEl) statusEl.textContent = "Saving…";
 473:       try {
 474:         await apiFetch(`/api/tasks/${encodeURIComponent(detail.state.task_id)}/edit-artifact`, {
 475:           method: "POST",
 476:           body: JSON.stringify({ name: base, content: textarea.value }),
 477:         });
 478:         if (statusEl) statusEl.textContent = "Saved.";
 479:         loadDetail(detail.state.task_id).catch(() => {});
 480:       } catch (err) {
 481:         if (statusEl) statusEl.textContent = `Error: ${err.message}`;
 482:       }
 483:     });
 484:   });
 485:   body.querySelectorAll(".phase-artifact-revert").forEach((btn) => {
 486:     btn.addEventListener("click", async () => {
 487:       const base = btn.dataset.base;
 488:       if (!confirm(`Discard your edits to ${base}?`)) return;
 489:       try {
 490:         await apiFetch(`/api/tasks/${encodeURIComponent(detail.state.task_id)}/edit-artifact`, {
 491:           method: "POST",
 492:           body: JSON.stringify({ name: base, content: null }),
 493:         });
 494:         loadDetail(detail.state.task_id).catch(() => {});
 495:       } catch (err) {
 496:         showBanner(err.message);
 497:       }
 498:     });
 499:   });
 500: }
