 510: function renderGoal(task) {
 511:   const el = $("goalText");
 512:   if (!el) return;
 513:   const framing = task.framing && typeof task.framing === "object" ? task.framing : {};
 514:   const statement = String(framing.problem_statement || "").trim();
 515:   const nonGoals = Array.isArray(framing.non_goals) ? framing.non_goals.filter((x) => String(x || "").trim()) : [];
 516:   const assumptions = Array.isArray(framing.assumptions) ? framing.assumptions.filter((x) => String(x || "").trim()) : [];
 517:   const raw = String(task.goal?.raw_request || task.title || "").trim();
 518:   if (!statement) {
 519:     el.classList.add("copy-block");
 520:     el.classList.remove("goal-structured");
 521:     el.innerHTML = "";
 522:     el.textContent = raw || "Framer hasn't drafted a problem statement yet.";
 523:     return;
 524:   }
 525:   el.classList.remove("copy-block");
 526:   el.classList.add("goal-structured");
 527:   const parts = [
 528:     `<div class="goal-section"><div class="goal-label">Problem statement</div><p>${escapeHtml(statement)}</p></div>`,
 529:   ];
 530:   if (nonGoals.length) {
 531:     parts.push(`<div class="goal-section"><div class="goal-label">Non-goals</div><ul>${nonGoals.map((x) => `<li>${escapeHtml(x)}</li>`).join("")}</ul></div>`);
 532:   }
 533:   if (assumptions.length) {
 534:     parts.push(`<div class="goal-section"><div class="goal-label">Assumptions</div><ul>${assumptions.map((x) => `<li>${escapeHtml(x)}</li>`).join("")}</ul></div>`);
 535:   }
 536:   if (raw && raw !== statement) {
 537:     parts.push(`<details class="goal-raw"><summary>Original request</summary><pre>${escapeHtml(raw)}</pre></details>`);
 538:   }
 539:   el.innerHTML = parts.join("");
 540: }
