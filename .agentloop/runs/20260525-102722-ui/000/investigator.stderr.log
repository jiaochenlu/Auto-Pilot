 578:   box-shadow: var(--shadow-sm);
 579: }
 580: 
 581: .copy-block, .log-block, .command-block {
 582:   background: var(--panel-2);
 583:   border: 1px solid var(--line-soft);
 584:   padding: 14px 16px;
 585:   border-radius: var(--radius);
 586:   white-space: pre-wrap;
 587:   word-break: break-word;
 588:   overflow: auto;
 589:   line-height: 1.55;
 590:   font-family: var(--mono);
 591:   font-size: 12.5px;
 592:   color: var(--ink-soft);
 593:   margin: 0;
 594: }
 595: .copy-block { min-height: 140px; max-height: 320px; }
 596: .command-block { margin-bottom: 14px; font-size: 12px; max-height: 200px; }
 597: .log-block { max-height: 460px; font-size: 12px; }
 598: 
 599: .phase-list { display: grid; gap: 0; min-width: 0; }
 600: .phase-item {
 601:   display: grid;
 602:   grid-template-columns: minmax(0, 1fr) auto;
 603:   gap: 12px;
