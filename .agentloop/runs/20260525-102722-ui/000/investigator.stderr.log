 107:         if isinstance(command, str) and shutil.which(command):
 108:             return "active", "configured and command is on PATH"
 109:         if isinstance(command, str) and Path(command).exists():
 110:             return "active", "configured and command path exists"
 111:         return "configured_missing", "configured but command was not found"
