 831: function artifactPhase(name) {
 832:   const n = String(name || "").toLowerCase();
 833:   if (n.startsWith("framing.")) return "Framing";
 834:   if (n === "dossier.md") return "Research";
 835:   if (n === "proposal.md" || n.startsWith("acceptance.") || n === "test-plan.md") return "Design";
 836:   if (/^review-.*\.json$/i.test(name)) return "Reviews";
 837:   if (n === "final-report.md") return "Final";
 838:   return "Other";
 839: }
 840: 
 841: const ARTIFACT_PHASE_ORDER = ["Framing", "Research", "Design", "Reviews", "Final", "Other"];
 842: 
 843: function renderArtifacts(detail) {
 844:   const list = $("artifactList");
 845:   list.innerHTML = "";
 846:   const mdArtifacts = (detail.artifacts || []).filter((a) => /\.md$/i.test(a.name || ""));
 847:   if (!mdArtifacts.length) {
 848:     list.innerHTML = '<div class="task-sub">No markdown artifacts yet.</div>';
 849:     return;
 850:   }
 851:   const groups = new Map();
 852:   for (const artifact of mdArtifacts) {
 853:     const phase = artifactPhase(artifact.name);
 854:     if (!groups.has(phase)) groups.set(phase, []);
 855:     groups.get(phase).push(artifact);
 856:   }
 857:   for (const phase of ARTIFACT_PHASE_ORDER) {
 858:     const items = groups.get(phase);
 859:     if (!items?.length) continue;
 860:     const group = document.createElement("section");
 861:     group.className = "artifact-group";
 862:     const head = document.createElement("div");
 863:     head.className = "artifact-group-head";
 864:     head.innerHTML = `<h3>${escapeHtml(phase)}</h3><span class="task-sub">${items.length} file${items.length === 1 ? "" : "s"}</span>`;
 865:     group.appendChild(head);
 866:     for (const artifact of items) {
 867:       const node = document.createElement("section");
 868:       node.className = "artifact-item";
 869:       const truncated = artifact.preview?.truncated ? ` · truncated ${artifact.preview.bytes_returned}/${artifact.preview.bytes_total} bytes` : "";
 870:       const itemHead = document.createElement("div");
 871:       itemHead.className = "artifact-head";
 872:       itemHead.innerHTML = `<strong>${escapeHtml(artifact.name)}</strong><span class="task-sub">${artifact.size} bytes${truncated}</span>`;
 873:       const body = document.createElement("div");
 874:       body.className = "markdown-body";
 875:       body.innerHTML = renderMarkdown(artifact.preview?.content || "");
 876:       node.appendChild(itemHead);
 877:       node.appendChild(body);
 878:       group.appendChild(node);
 879:     }
 880:     list.appendChild(group);
 881:   }
 882: }
