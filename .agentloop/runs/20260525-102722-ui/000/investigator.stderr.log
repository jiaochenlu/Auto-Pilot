 631: .framing-review-panel,
 632: .research-progress-panel,
 633: .execution-approval-panel {
 634:   display: grid;
 635:   gap: 14px;
 636:   margin-bottom: 22px;
 637:   padding: 18px 20px;
 638:   border: 1px solid #bfd4fb;
 639:   border-radius: var(--radius-lg);
 640:   background: #f6f9ff;
 641:   box-shadow: var(--shadow-sm);
 642: }
 643: .framing-review-panel.hidden,
 644: .research-progress-panel.hidden { display: none; }
 645: .research-progress-panel {
 646:   border-color: #f0d9a4;
 647:   background: #fffaf0;
 648: }
 649: .execution-approval-panel {
 650:   border-color: #b9e6c7;
 651:   background: #f4fff7;
 652: }
 653: .execution-approval-panel.hidden { display: none; }
 654: .framing-review-head,
 655: .research-progress-head,
 656: .execution-approval-head {
 657:   display: grid;
 658:   grid-template-columns: minmax(0, 1fr) auto;
 659:   gap: 14px;
 660:   align-items: start;
