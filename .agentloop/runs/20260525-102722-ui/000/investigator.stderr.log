 228: function configurePrimaryAction(detail) {
 229:   const task = detail.state;
 230:   const actions = detail.actions || {};
 231:   const status = String(task.status || "").toUpperCase();
 232:   const primary = $("primaryActionBtn");
 233:   const cancel = $("cancelBtn");
 234:   const deleteBtn = $("deleteBtn");
 235: 
 236:   let primaryConfig = null;
 237:   if (status === "WAITING_FOR_ALIGNMENT" && actions.approve?.enabled) {
 238:     primaryConfig = { label: "Approve plan & run", handler: () => approveAndRun(), title: "" };
 239:   } else if (status === "READY_TO_START" && actions.run?.enabled) {
 240:     primaryConfig = { label: "Run", handler: () => mutate("run"), title: "" };
 241:   } else if (["RUNNING", "EXECUTING", "IMPLEMENTING_AND_TESTING", "REVIEWING"].includes(status)) {
 242:     primaryConfig = { label: `Running · iter ${task.iteration ?? "-"}/${task.max_iterations ?? "-"}`, handler: null, title: "Task in progress", disabled: true };
 243:   } else if (status === "FRAMING_REVIEW") {
 244:     if (actions.start_research?.enabled) {
 245:       primaryConfig = { label: "Start research →", handler: () => startResearch(), title: "" };
 246:     } else if (actions.submit_framing?.enabled) {
 247:       primaryConfig = { label: "Submit answers", handler: () => submitFramingAnswers(), title: "Answer the open questions to continue" };
 248:     }
 249:   } else if (["INVESTIGATING", "DESIGNING"].includes(status)) {
 250:     primaryConfig = { label: "Researching…", handler: null, title: "Investigator and Architect are running", disabled: true };
 251:   } else if (status === "CREATED" || status === "FRAMING") {
 252:     primaryConfig = { label: "Framing…", handler: null, title: "Framer is drafting the problem statement", disabled: true };
 253:   } else if (status === "WAITING_FOR_HUMAN") {
 254:     primaryConfig = { label: "Resume", handler: () => {
 255:       const panel = $("humanReviewPanel");
 256:       if (panel && !panel.classList.contains("hidden")) {
 257:         panel.scrollIntoView({ behavior: "smooth", block: "start" });
 258:       }
 259:     }, title: "Review the blocker, then resume" };
 260:   } else if (status === "DONE") {
 261:     primaryConfig = { label: "View report", handler: () => {
 262:       [...$("detailTabs").querySelectorAll("button")].forEach((b) => b.classList.toggle("active", b.dataset.tab === "artifacts"));
 263:       [...document.querySelectorAll(".tab-panel")].forEach((p) => p.classList.toggle("active", p.id === "artifactsTab"));
 264:     }, title: "Open the final report" };
 265:   }
 266: 
 267:   if (primaryConfig) {
 268:     primary.hidden = false;
 269:     primary.textContent = primaryConfig.label;
 270:     primary.disabled = !!primaryConfig.disabled || state.busy;
 271:     primary.title = primaryConfig.title || "";
 272:     primary.onclick = primaryConfig.handler;
 273:   } else {
 274:     primary.hidden = true;
 275:     primary.onclick = null;
 276:   }
 277: 
 278:   cancel.hidden = !actions.cancel?.enabled && status !== "RUNNING";
 279:   cancel.disabled = !actions.cancel?.enabled || state.busy;
 280:   cancel.title = actions.cancel?.reason || "";
 281:   cancel.onclick = () => mutate("cancel");
 282: 
 283:   setAction("deleteBtn", actions.delete, () => openDeleteDialog());
 284:   deleteBtn.hidden = !actions.delete?.enabled;
 285: }
