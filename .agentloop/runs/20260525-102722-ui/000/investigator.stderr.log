 343: function renderBasic(detail, phase) {
 344:   const task = detail.state;
 345:   const isCancelled = String(task.status || "").toUpperCase() === "CANCELLED";
 346:   // gate sub-panels: each render*() already toggles its own hidden class based on detail
 347:   // but we additionally force-hide ones that don't belong to current phase
 348:   const gate = (id, allowed) => {
 349:     const el = $(id);
 350:     if (!el) return;
 351:     if (!allowed) el.classList.add("hidden");
 352:   };
 353:   // Run sub-renderers first
 354:   renderFramingReview(detail);
 355:   renderResearchProgress(detail);
 356:   renderExecutionApproval(detail);
 357:   renderHumanReview(detail);
 358:   renderGoal(task);
 359:   // Then phase-gate (interactive panels hide entirely for cancelled tasks)
 360:   gate("framingReviewPanel", !isCancelled && phase === "framing");
 361:   gate("researchProgressPanel", !isCancelled && phase === "research");
 362:   gate("executionApprovalPanel", !isCancelled && phase === "approval");
 363:   gate("humanReviewPanel", !isCancelled && phase === "running");
 364:   // Goal & acceptance visibility
 365:   const goalSec = $("goalSection");
 366:   const accSec = $("acceptanceSection");
 367:   if (goalSec) goalSec.classList.toggle("hidden", phase === "done");
 368:   if (accSec) accSec.classList.toggle("hidden", phase === "framing" || phase === "done");
 369:   // Acceptance content
 370:   renderAcceptance(task);
 371:   // Phase-specific artifact preview (for cancelled tasks in framing phase, surface framing.md
 372:   // since the interactive panel is hidden; other phases already list artifacts via PHASE_ARTIFACTS)
 373:   const wantedOverride = isCancelled && phase === "framing" ? ["framing.md"] : null;
 374:   renderPhaseArtifacts(detail, phase, wantedOverride);
 375:   // Done placeholder
 376:   const empty = $("basicEmpty");
 377:   if (empty) empty.classList.toggle("hidden", phase !== "done");
 378: }
