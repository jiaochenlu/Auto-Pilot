 605:   align-items: center;
 606:   border-bottom: 1px solid var(--line-soft);
 607:   font-size: 13px;
 608:   font-weight: 500;
 609:   min-width: 0;
 610: }
 611: .phase-item:last-child { border-bottom: none; }
 612: .phase-item > strong {
 613:   min-width: 0;
 614:   overflow: hidden;
 615:   text-overflow: ellipsis;
 616:   white-space: nowrap;
 617:   font-weight: 600;
 618:   color: var(--ink-soft);
 619: }
 620: 
 621: .human-review-panel {
 622:   display: grid;
 623:   gap: 16px;
 624:   margin-bottom: 22px;
 625:   padding: 18px 20px;
 626:   border: 1px solid #f1cf83;
 627:   border-radius: var(--radius-lg);
 628:   background: #fffaf0;
 629:   box-shadow: var(--shadow-sm);
