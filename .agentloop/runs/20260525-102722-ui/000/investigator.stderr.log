 705: .design-package-card {
 706:   min-width: 0;
 707:   display: grid;
 708:   gap: 6px;
 709:   padding: 12px;
 710:   background: #fff;
 711:   border: 1px solid var(--line-soft);
 712:   border-radius: var(--radius-sm);
