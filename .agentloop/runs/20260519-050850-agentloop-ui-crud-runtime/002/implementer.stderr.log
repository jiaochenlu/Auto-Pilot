                self.assertIsInstance(deleted, dict)
                self.assertTrue(deleted["deleted"])
                self.assertFalse((root / ".agentloop" / "tasks" / task_id).exists())
            finally:
                server.shutdown()
                server.server_close()
                thread.join(timeout=5)


if __name__ == "__main__":
    unittest.main()


