{
  "schema_version": 1,
  "default_runtime": "manual",
  "runtimes": {
    "manual": {
      "adapter": "manual",
      "description": "Write prompts to disk and wait for the user to provide artifacts."
    },
    "example-agent": {
      "adapter": "command",
      "command": "python",
      "args": [
        "--version"
      ]
    },
    "codex": {
      "adapter": "command",
      "command": "C:\\Users\\chenlujiao\\AppData\\Roaming\\npm\\node_modules\\@openai\\codex\\node_modules\\@openai\\codex-win32-x64\\vendor\\x86_64-pc-windows-msvc\\codex\\codex.exe",
      "args": [
        "exec",
        "--skip-git-repo-check",
        "--sandbox",
        "workspace-write",
        "-"
      ],
      "stdin_file": "{prompt_file}"
    },
    "claude-code": {
      "adapter": "command",
      "command": "C:\\Users\\chenlujiao\\AppData\\Roaming\\npm\\node_modules\\@anthropic-ai\\claude-code\\bin\\claude.exe",
      "args": [
        "--print",
        "--permission-mode",
        "acceptEdits"
      ],
      "stdin_file": "{prompt_file}"
    },
    "copilot": {
      "adapter": "command",
      "command": "C:\\Program Files\\GitHub CLI\\gh.EXE",
      "args": [
        "copilot",
        "suggest",
        "--file",
        "{prompt_file}"
      ]
    }
  },
  "roles": {
    "analyst": {
      "runtime": "claude-code"
    },
    "architect": {
      "runtime": "claude-code"
    },
    "implementer": {
      "runtime": "claude-code"
    },
    "tester": {
      "runtime": "claude-code"
    },
    "reviewer": {
      "runtime": "claude-code"
    },
    "integrator": {
      "runtime": "claude-code"
    }
  },
  "test_commands": [
    "python -m unittest discover -s tests"
  ],
  "max_iterations": 7
}
