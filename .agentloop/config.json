{
  "schema_version": 1,
  "default_runtime": "manual",
  "runtimes": {
    "manual": {
      "adapter": "manual",
      "description": "Write prompts to disk and wait for the user to provide artifacts."
    },
    "example-agent": {
      "adapter": "command",
      "command": "python",
      "args": [
        "--version"
      ]
    },
    "codex": {
      "adapter": "command",
      "command": "C:\\.tools\\.npm-global\\codex.cmd",
      "args": [],
      "stdin_file": "{prompt_file}",
      "supports_resume": true,
      "session_id_regex": "session id:\\s*([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})",
      "new_session_args": [
        "exec",
        "--skip-git-repo-check",
        "--sandbox",
        "danger-full-access",
        "-"
      ],
      "resume_args": [
        "exec",
        "resume",
        "{session_id}",
        "--skip-git-repo-check",
        "-"
      ]
    },
    "claude-code": {
      "adapter": "command",
      "command": "C:\\.tools\\.npm-global\\claude.cmd",
      "args": [
        "--print",
        "--permission-mode",
        "bypassPermissions"
      ],
      "stdin_file": "{prompt_file}",
      "supports_resume": true,
      "new_session_args": ["--session-id", "{session_id}"],
      "resume_args": ["--resume", "{session_id}"]
    },
    "copilot": {
      "adapter": "command",
      "command": "C:\\.tools\\.npm-global\\copilot.cmd",
      "args": [
        "--allow-all",
        "--no-color",
        "-s"
      ],
      "supports_resume": true,
      "new_session_args": [
        "--session-id",
        "{session_id}",
        "-p",
        "{prompt_text}"
      ],
      "resume_args": [
        "--resume",
        "{session_id}",
        "-p",
        "{prompt_text}"
      ]
    }
  },
  "roles": {
    "analyst": {
      "runtime": "codex"
    },
    "architect": {
      "runtime": "claude-code"
    },
    "implementer": {
      "runtime": "claude-code"
    },
    "tester": {
      "runtime": "claude-code"
    },
    "reviewer": {
      "runtime": "claude-code"
    },
    "integrator": {
      "runtime": "claude-code"
    },
    "framer": {
      "runtime": "claude-code"
    },
    "scanner": {
      "runtime": "claude-code"
    },
    "investigator": {
      "runtime": "claude-code"
    }
  },
  "test_commands": [
    "python -m unittest discover -s tests"
  ],
  "max_iterations": 7
}
